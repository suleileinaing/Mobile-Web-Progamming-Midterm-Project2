<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_post_detail"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCloseDetail"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="24sp"
            android:textColor="#29243B"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close photo details" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#29485C"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFavorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:gravity="center"
                android:text="♡"
                android:textSize="28sp"
                android:textColor="#6750A4"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Save or unsave this post" />

        </LinearLayout>


        <ImageView
            android:id="@+id/detailImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="Post photo" />

        <TextView
            android:id="@+id/detailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:textIsSelectable="true"
            android:textColor="#526B7A"
            android:lineSpacingExtra="4dp"/>

        <Button
            android:id="@+id/btnDeletePost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="게시물 삭제"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B42318"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>